{
  "name": "branch-validation",
  "version": "1.0.0",
  "description": "Claude Code skill for validating branch names against LightSpeed WP's org-wide branching strategy",
  "main": "SKILL.md",
  "scripts": {
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:verbose": "jest --verbose --coverage",
    "test:bats": "bats tests/*.bats",
    "test:bats:verbose": "bats --verbose tests/*.bats",
    "test:all": "npm test && npm run test:bats",
    "lint": "eslint scripts/ --fix",
    "validate": "npm run lint && npm test && npm run test:bats"
  },
  "keywords": [
    "branch-validation",
    "branching-strategy",
    "git",
    "cli",
    "skill",
    "claude"
  ],
  "author": "LightSpeed WP Team",
  "license": "Apache-2.0",
  "devDependencies": {
    "jest": "^29.7.0",
    "eslint": "^8.51.0",
    "lefthook": "^2.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lightspeedwp/branch-validation.git"
  },
  "bugs": {
    "url": "https://github.com/lightspeedwp/branch-validation/issues"
  },
  "homepage": "https://github.com/lightspeedwp/branch-validation#readme"
}
