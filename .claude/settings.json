{
  "version": "0.1",
  "project": {
    "name": "branch-validation-wordpress",
    "description": "Branch validation and workflow guidance for WordPress block development",
    "repository": "https://github.com/lightspeedwp/branch-validation",
    "type": "skill"
  },
  "codeEditor": {
    "theme": "auto",
    "fontSize": 13,
    "fontFamily": "monospace",
    "lineNumbers": true,
    "minimap": true,
    "wordWrap": "on"
  },
  "automation": {
    "runTestsOnSave": true,
    "runLintOnSave": true,
    "autoFormat": true
  },
  "claude": {
    "agents": "agents.md",
    "instructions": "claude.md",
    "contextFiles": [
      "README.md",
      "SKILL.md",
      "docs/ONBOARDING.md",
      "references/LIGHTSPEED_INTEGRATION.md"
    ]
  },
  "permissions": {
    "allowBashCommands": true,
    "allowFileEditing": true,
    "allowGitOperations": true,
    "allowExternalRequests": false
  },
  "branching": {
    "pattern": "{type}/block-{component}-{feature}",
    "validTypes": [
      "feat",
      "fix",
      "perf",
      "a11y",
      "security",
      "test",
      "ci",
      "refactor",
      "docs",
      "release",
      "hotfix",
      "research"
    ],
    "maxLength": 50,
    "enforceValidation": true
  },
  "testing": {
    "framework": "jest",
    "coverageThreshold": 85,
    "integrationTests": "bats",
    "e2eTests": "playwright"
  },
  "documentation": {
    "rootDocs": [
      "README.md",
      "SKILL.md",
      "AGENTS.md",
      "CLAUDE.md",
      "CHANGELOG.md"
    ],
    "docsFolder": "docs/",
    "skillsFolder": "skills/",
    "referencesFolder": "references/"
  }
}
